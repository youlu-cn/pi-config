{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "claude-light/claude-dark",
  "defaultProvider": "antigravity",
  "defaultModel": "gemini-4-hydrogen",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "enabledModels": [
    "antigravity/gemini-4-hydrogen",
    "antigravity/gemini-4-argon",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6.1-terra",
    "openai-codex/gpt-6-luna",
    "deepseek/deepseek-v4-pro",
    "deepseek/deepseek-flash",
    "cursor/default"
  ],
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "showHardwareCursor": true,
  "externalEditor": "nvim",
  "autocompleteMaxVisible": 8,
  "collapseChangelog": true,
  "treeFilterMode": "no-tools",
  "steeringMode": "all",
  "followUpMode": "all",
  "defaultTools": [
    "+codemode"
  ],
  "compaction": {
    "keepRecentTokens": 80000
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/badlogic/pi-subagent",
    "npm:@ff-labs/pi-fff",
    "npm:pi-cursor-sdk",
    "npm:pi-antigravity",
    "npm:@sentiolabs/pi-frontend-design"
  ],
  "extensions": [],
  "lastChangelogVersion": "1.5.2",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-cursor-sdk\",\"scope\":\"user\"}": "0.5.40"
  }
}