{
  "toolActivity": {
    "enabled": false
  },
  "workAnimation": {
    "enabled": true,
    "style": "claude",
    "intervalMs": 240,
    "placement": "aboveEditor",
    "showStats": true,
    "showTtft": true,
    "tokenRateMode": "average"
  },
  "agentSummary": {
    "enabled": true,
    "minToolCount": 1
  },
  "compactThinking": {
    "enabled": true,
    "previewLines": 3,
    "completedPreviewLines": 1,
    "animationIntervalMs": 90
  },
  "editorPrefix": {
    "enabled": true
  },
  "aliases": {
    "enabled": true
  },
  "specialCards": {
    "enabled": true
  },
  "claudeToolStyle": {
    "enabled": true,
    "mode": "on",
    "grouping": true,
    "diffViewMode": "auto",
    "diffIndicatorMode": "bars",
    "diffSplitMinWidth": 120,
    "editDiffCollapsedLines": 12,
    "writeDiffCollapsedLines": 8
  },
  "statusline": {
    "segments": [
      "model",
      "effort",
      "directory",
      "branch",
      "context",
      "usage",
      "cache",
      "extensions"
    ]
  },
  "startupHeader": {
    "enabled": true
  },
  "markdownEnhance": {
    "enabled": true
  },
  "contextCommand": {
    "enabled": true
  },
  "reference": {
    "enabled": true,
    "sessionReference": true,
    "subagentAutocomplete": true
  },
  "stickyUserMessage": {
    "enabled": true
  }
}
